# =============================================================================
# Matilha OS — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and never committed.
# =============================================================================

# --- Asaas Billing --------------------------------------------------------- #
# Your Asaas API key (starts with $aact_ for production, $aatp_ for sandbox)
ASAAS_API_KEY=

# API base URL — switch between sandbox and production
# Sandbox:    https://sandbox.asaas.com/api/v3
# Production: https://www.asaas.com/api/v3
ASAAS_BASE_URL=https://sandbox.asaas.com/api/v3

# Secret token used to validate incoming Asaas webhook calls.
# Set the same value in the Asaas dashboard under Configurações → Webhooks.
ASAAS_WEBHOOK_TOKEN=

# User-Agent sent with every Asaas API request (good practice for support)
ASAAS_USER_AGENT=matilha-os/1.0

# --- Application ----------------------------------------------------------- #
# Full public URL of this app (no trailing slash). Used in webhook registration.
NEXT_PUBLIC_APP_URL=http://localhost:4000

# Secret used to sign internal API tokens (min 32 chars, random string)
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Data Storage ---------------------------------------------------------- #
# Absolute path where JSON data files are stored on the server.
# Defaults to <project-root>/data if not set.
# DATA_DIR=/var/data/matilha
